{
  "schemaVersion": 1,
  "title": "Social graph collection input",
  "type": "object",
  "properties": {
    "targets": {
      "title": "Targets",
      "description": "Platform/username pairs to collect",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "title": "Target",
        "type": "object",
        "required": ["platform", "username"],
        "properties": {
          "platform": {
            "title": "Platform",
            "type": "string",
            "enum": ["instagram", "x", "tiktok"]
          },
          "username": {
            "title": "Username",
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "scrapeType": {
      "title": "Scrape type",
      "type": "string",
      "enum": ["followers", "following", "both"],
      "default": "followers"
    },
    "maxFollowers": {
      "title": "Maximum followers",
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maxFollowing": {
      "title": "Maximum following",
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "concurrency": {
      "title": "Concurrency",
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 2
    },
    "eventBufferSize": {
      "title": "Event buffer size",
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  },
  "required": ["targets", "scrapeType"],
  "additionalProperties": false
}
